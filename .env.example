# Settings for the Switch stack in docker/docker-compose.yml. `mise run switch:init-env` writes a
# .env with the required values and fresh secrets; copy the optional ones you need from here.

# --- Required -------------------------------------------------------------------------------

# Postgres: the owner account, and the unprivileged role switch-core connects as.
DB_NAME=switch
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=
DB_USER=switch_app
DB_PASSWORD=

# Token agents present to register with Switch.
AGENT_REGISTRATION_TOKEN=

# Encryption keys for stored credentials, as <key id>:<64 hex chars> (openssl rand -hex 32).
SECRET_KEYS=

# Dashboard admin login, and where the dashboard is served.
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=
FRONTEND_BASE_URL=http://localhost:13000

# Cloudflare tunnel from the dashboard (Zero Trust > Networks > Tunnels): its token, and the
# public hostname routed to http://switch:8000, where chat platforms deliver webhooks.
CLOUDFLARE_TUNNEL_TOKEN=
MESSAGING_PUBLIC_URL=

# Signs the credentials of machines that run agents (openssl rand -hex 32).
CONTROLLER_TOKEN_SECRET=

# --- Agent controller (docker/agent-controller) ---------------------------------------------

# One-time code from Machines > Add machine; works once, for ten minutes, and is kept enrolled.
SWITCH_CONTROLLER_ENROLL_CODE=
# Claude login for the agents: a token from `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OpenAI API key that transcribes voice notes sent in the room (`transcribe`); without it they
# can't be read.
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Launch room (the agents' site workflow) -------------------------------------------------

# Domain the sites are served on, as preview-<name>.<domain> and <name>.<domain>. Route the tunnel's
# wildcard hostname *.<domain> to http://agent-controller:8080.
SITES_DOMAIN=
# Folder of templates new sites start from (`site templates` lists them); the repo's templates/ is
# mounted there. Each template has a launch-room.json naming what it is for and its build folder.
# SITE_TEMPLATES=/home/node/templates
# Formspree CLI project the sites' signup forms are deployed to (New Project > CLI Project); both
# values are in the project's Settings tab.
FORMSPREE_PROJECT_ID=
FORMSPREE_DEPLOY_KEY=

# --- Video crew (studio + renderer) ---------------------------------------------------------

# The narration voice for explainers, one of Microsoft Edge's free voices (no key needed), such as
# en-US-AndrewNeural, en-US-AriaNeural or en-GB-RyanNeural.
# EXPLAINER_VOICE=en-US-AndrewNeural

# --- Optional: host ports (all bound to 127.0.0.1) ------------------------------------------

# API_HOST_PORT=18000
# GATEWAY_HOST_PORT=13000
# POSTGRES_HOST_PORT=5433

# --- Optional: chat platforms, fill in the ones you connect ---------------------------------

# Slack
# SLACK_APP_CLIENT_ID=
# SLACK_APP_CLIENT_SECRET=
# SLACK_APP_SIGNING_SECRET=

# Discord
# DISCORD_APP_CLIENT_ID=
# DISCORD_APP_CLIENT_SECRET=
# DISCORD_APP_BOT_TOKEN=
# DISCORD_APP_APPLICATION_ID=

# Microsoft Teams
# TEAMS_APP_CLIENT_ID=
# TEAMS_APP_TENANT_ID=
# TEAMS_APP_CLIENT_SECRET=

# Telegram
# TELEGRAM_APP_BOT_TOKEN=
# TELEGRAM_APP_WEBHOOK_SECRET=
